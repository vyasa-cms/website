{
  "name": "vyasa-website",
  "private": true,
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "prepare:content": "pnpm sync:docs && pnpm gen:api",
    "dev": "pnpm prepare:content && next dev",
    "build": "pnpm prepare:content && next build",
    "start": "serve out",
    "types:check": "pnpm prepare:content && next typegen && tsc --noEmit",
    "lint": "eslint"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-openapi": "12.5.4",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.17",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  }
}
